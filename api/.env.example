# Copy to api/.env. No real data is created unless you run setup/seed.
DATA_MODE=sqlserver
PORT=4000
APP_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
SQL_HOST=127.0.0.1
SQL_PORT=1433
SQL_DATABASE=BoatCore
SQL_USER=boatcore_app
SQL_PASSWORD=CHANGE_ME
SQL_ENCRYPT=false
SQL_TRUST_CERT=true
# Setup only: a separate login permitted to create databases/tables.
SQL_SETUP_USER=sa
SQL_SETUP_PASSWORD=CHANGE_ME
# Required seed configuration; never exposed by the API.
SEED_USERS_JSON=
# false seeds empty business tables; true seeds fictional portfolio data.
SEED_SAMPLE_DATA=false
# Optional direct guest sign-in button; grants only read permission.
PUBLIC_GUEST_ACCESS=true

# Set true when publishing the fictional portfolio workspace. Disables PIN login.
PUBLIC_REVIEW_ONLY=false
