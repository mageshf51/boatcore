{
  "name": "boatcore",
  "private": true,
  "workspaces": [
    "app",
    "api"
  ],
  "scripts": {
    "dev": "concurrently -k -n API,APP \"npm run dev -w api\" \"npm run dev -w app\"",
    "build": "npm run build -w api && npm run build -w app",
    "typecheck": "tsc --noEmit -p api && tsc --noEmit -p app",
    "test": "node --import tsx --test tests/*.test.ts",
    "db:setup": "npm run db:setup -w api",
    "seed": "npm run seed -w api",
    "demo": "cross-env DATA_MODE=demo npm run dev",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "decimal.js": "^10.6.0",
    "zod": "^4.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "concurrently": "^9.2.0",
    "cross-env": "^10.1.0",
    "prettier": "^3.10.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22.13"
  },
  "type": "module"
}
